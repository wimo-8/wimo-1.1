generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roles        Role[]
  sessions     Session[]
  otpCodes     OTP[]
  sellerProfile SellerProfile?
  orders       Order[]
  submissions  Submission[]
  ratings      Rating[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  permissions Permission[]
  users       User[]
}

model Permission {
  id   Int    @id @default(autoincrement())
  key  String @unique
  roles Role[]
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OTP {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SellerProfile {
  id          String         @id @default(cuid())
  user        User           @relation(fields: [userId], references: [id])
  userId      String         @unique
  displayName String
  bio         String?
  skills      String[]
  status      SellerStatus   @default(PENDING)
  services    Product[]
  portfolio   PortfolioItem[]
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

model PortfolioItem {
  id          String   @id @default(cuid())
  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  sellerId    String
  title       String
  description String
  mediaUrl    String
  createdAt   DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  products  Product[]
}

enum ProductType {
  DIGITAL_KEY
  ACCOUNT
  SERVICE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
}

model Product {
  id          String       @id @default(cuid())
  title       String
  description String
  price       Float
  type        ProductType
  fulfillmentHours Int     @default(1)
  status      PublishStatus @default(DRAFT)
  category    Category?    @relation(fields: [categoryId], references: [id])
  categoryId  String?
  media       Media[]
  stock       StockKey[]
  seller      SellerProfile? @relation(fields: [sellerId], references: [id])
  sellerId    String?
  orderItems  OrderItem[]
  ratings     Rating[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockKey {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  encryptedKey String
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  consumptions StockConsumption[]
}

model StockConsumption {
  id         String   @id @default(cuid())
  stockKey   StockKey @relation(fields: [stockKeyId], references: [id])
  stockKeyId String
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String @unique
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  RECEIVED
  WAITING_PAYMENT
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  status       OrderStatus @default(RECEIVED)
  total        Float
  paymentMethod PaymentMethod
  paymentProofs PaymentProof[]
  items        OrderItem[]
  timeline     OrderTimelineEvent[]
  paymentAttempts PaymentAttempt[]
  notes        AdminNote[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  quantity    Int      @default(1)
  unitPrice   Float
  deliveryDetails String?
  stockConsumption StockConsumption?
}

enum PaymentMethod {
  BALANCE
  QI_CARD
  BANK_TRANSFER
  WHATSAPP_CONFIRM
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  method    PaymentMethod
  reference String?
  amount    Float
  status    String
  createdAt DateTime @default(now())
}

model PaymentProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  imageUrl  String
  note      String?
  createdAt DateTime @default(now())
}

model OrderTimelineEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  status    OrderStatus
  message   String
  createdAt DateTime @default(now())
}

model AdminNote {
  id        String   @id @default(cuid())
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?
  content   String
  createdBy String
  createdAt DateTime @default(now())
}

model Submission {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  description String
  status    SubmissionStatus @default(PENDING)
  createdAt DateTime @default(now())
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String
  recipient String
  content   String
  createdAt DateTime @default(now())
}

model Setting {
  id      Int    @id @default(autoincrement())
  key     String @unique
  value   String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  createdAt DateTime @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
}
